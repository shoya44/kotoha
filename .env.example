# このファイルは設定の初期値です。通常は settings.bat から .env を編集してください。
# 変更後はサーバーを停止して start.bat で再起動してください。
# true/false は有効/無効。空欄にできる項目はコメントで説明しています。

# Gemini：キーは自分の値を設定（表示・ログ出力しません）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
KOTOHA_MAX_OUTPUT_TOKENS=1024
KOTOHA_TIMEOUT_SECONDS=60
KOTOHA_TEMPERATURE=0.8
# APIリクエストの試行回数（初回を含む）
KOTOHA_LLM_ATTEMPTS=2

# 保存先：相対パスはプロジェクト直下基準
KOTOHA_DB_PATH=./data/kotoha.sqlite3
# バックアップ保持数（これより古いファイルはbackup実行時に削除）
KOTOHA_BACKUP_KEEP=7
# 自動バックアップの間隔（秒）。Web起動中とCUI終了時に確認します
KOTOHA_BACKUP_INTERVAL_SECONDS=86400

# 会話で参照する直近履歴
KOTOHA_RECENT_TURNS=5
KOTOHA_RECENT_CHARS=3000
KOTOHA_FAST_ENABLED=false
KOTOHA_FAST_MAX_CHARS=40
# trueで処理モード・詳細サーバーログ・アクセスログを表示
KOTOHA_DEBUG=false

# Web：トークンを設定。HOSTはPC内専用なら127.0.0.1
KOTOHA_WEB_TOKEN=
KOTOHA_WEB_HOST=127.0.0.1
KOTOHA_WEB_PORT=8000
# Web画面で最初に表示する履歴件数
KOTOHA_WEB_HISTORY_LIMIT=40

# 音声合成：AivisSpeechなどVOICEVOX互換エンジンを使います
# falseで読み上げを止めます。エンジンが未起動でも会話はそのまま続きます
KOTOHA_VOICE_ENABLED=true
KOTOHA_VOICE_BASE_URL=http://127.0.0.1:10101
# 話者スタイルID。エンジンの /speakers で確認できます（既定はコハクのノーマル）
KOTOHA_VOICE_STYLE_ID=1878365376
KOTOHA_VOICE_TIMEOUT_SECONDS=60
# 起動時に音声エンジンを自動で立ち上げます（画面は出しません）
KOTOHA_AIVIS_AUTO_START=true
# 空欄はAivisSpeechの標準インストール先。指定する場合はフォルダー
KOTOHA_AIVIS_DIR=

# 記憶の想起：Ollamaで意味の近さを測り、言葉が一致しない記憶も思い出します
# falseで止まります。Ollamaが未起動でも会話はそのまま続きます
KOTOHA_EMBED_ENABLED=true
KOTOHA_EMBED_BASE_URL=http://127.0.0.1:11434
# 変えたときは、次の巡回で全部の記憶が作り直されます（71件で35秒ほど）
KOTOHA_EMBED_MODEL=bge-m3
# これより長く放っておくとモデルが眠り、次の1回が遅くなります
KOTOHA_EMBED_KEEP_ALIVE=30m
# 会話のたびに待つ上限。超えたら想起は今までどおりのタグ検索だけになります
KOTOHA_EMBED_TIMEOUT_SECONDS=1.5
# 裏で記憶を変換するときの上限。こちらは会話を待たせないので長めでよい
KOTOHA_EMBED_BUILD_TIMEOUT_SECONDS=120
# 1回の巡回で変換する記憶の件数
KOTOHA_EMBED_BATCH=32
KOTOHA_EMBED_MAX_CHARS=400
# 想起6枠のうち、意味の近さで選ぶぶん。0にすると想起は従来どおりに戻ります
KOTOHA_EMBED_RESERVE=2
# この近さに届かない記憶は出しません。上げるほど「確かに関係あるとき」だけ出ます
KOTOHA_EMBED_FLOOR=0.62
# 照らし合わせる文に足す、直前のやりとりの行数。短い発言の意味を定めるため
KOTOHA_EMBED_CONTEXT_LINES=2
# 失敗したあと、次に試すまで待つ秒数。止まっている間、会話が待たされないように
KOTOHA_EMBED_RETRY_SECONDS=60
# これ以上近い記憶は作らず、既存のほうを確かめ直します（言い直しだけを拾う高さ）
KOTOHA_EMBED_MERGE_FLOOR=0.90
# これ以上近い記憶どうしを、想起でたどれるように結びます。0でやめられます
KOTOHA_EMBED_LINK_FLOOR=0.80
KOTOHA_EMBED_LINK_LIMIT=3
# 起動時にOllamaを自動で立ち上げます（画面は出しません）
KOTOHA_OLLAMA_AUTO_START=true
# 空欄ならPATH、次にOllamaの標準インストール先を見ます。指定する場合はフォルダー
KOTOHA_OLLAMA_DIR=

# PCの様子：起動からの時間と、前面のアプリ名だけを見ます
# ウィンドウの題名や中身は読みません。falseで完全に止まります
KOTOHA_PRESENCE_ENABLED=true
# 頼まれたら、決まった操作（エンジンの起動・停止、自分の入れ直し）をします
# できることは talk/actions.py の一覧だけです。falseで何もしなくなります
KOTOHA_ACTIONS_ENABLED=true

# 通知（OneSignal 経由の Web Push）
# iPhoneはiOS 16.4以降・ホーム画面に追加したPWAでのみ受け取れます
KOTOHA_PUSH_ENABLED=false
# OneSignalのダッシュボードで作ったアプリの値を入れてください
KOTOHA_ONESIGNAL_APP_ID=
# REST APIキー。これは秘密です。人に見せないでください
KOTOHA_ONESIGNAL_API_KEY=
# 通知をタップしたときに開くURL（TailscaleのHTTPS URLなど）
KOTOHA_PUSH_OPEN_URL=
# falseにすると本文を載せず「ことはから」とだけ出します
# 会話の中身をOneSignalに渡したくない場合はfalseに
KOTOHA_PUSH_SHOW_TEXT=true
# 空きがこれを切ったら教えます（GB）
KOTOHA_DISK_WARN_GB=20

# 根を詰めすぎ・夜更かしに気づいたら声をかける
KOTOHA_LOOKOUT_ENABLED=false
# 同じアプリをこれだけ続けたら休ませる（時間）
KOTOHA_LOOKOUT_SIT_HOURS=3
# この時刻からこの時刻までに起きていたら、夜更かし扱い
KOTOHA_LOOKOUT_LATE_HOUR=2
KOTOHA_LOOKOUT_MORNING_HOUR=5

# 朝のひとこと（日付・天気・服装）
KOTOHA_BRIEFING_ENABLED=false
# 何時に言うか
KOTOHA_BRIEFING_HOUR=8
# その時刻にPCが寝ていた場合、何時間後まで遅れて言ってよいか
KOTOHA_BRIEFING_GRACE_HOURS=3
# 天気を見る場所。既定は東京駅。自宅の座標は .env に書いてください
KOTOHA_LATITUDE=35.681
KOTOHA_LONGITUDE=139.767

# ことはのほうから声をかける
KOTOHA_REACH_OUT_ENABLED=false
# 会話が途切れてからこれだけたったら
KOTOHA_REACH_OUT_AFTER_HOURS=5
# 一度声をかけたら、次までこれだけ空けます
KOTOHA_REACH_OUT_INTERVAL_HOURS=6
# 声をかけてよい時間帯（この時刻から、この時刻の手前まで）
KOTOHA_REACH_OUT_FROM_HOUR=9
KOTOHA_REACH_OUT_TO_HOUR=23

# ワンクリック起動
KOTOHA_BROWSER_AUTO_OPEN=true
KOTOHA_TAILSCALE_AUTO_START=true
# 起動時にTailscale Serveで配信し、そのHTTPS URLを開く
KOTOHA_TAILSCALE_SERVE_ENABLED=true
KOTOHA_TAILSCALE_HTTPS_PORT=443
# 空欄はTailscaleの標準インストール先。指定する場合はフォルダー
KOTOHA_TAILSCALE_DIR=
KOTOHA_STARTUP_TIMEOUT_SECONDS=30

# 記憶整理：CUIで整理を始める未処理ターン数。Webは会話が途切れてから整理します
KOTOHA_CONSOLIDATE_TURNS=10
# 以下はWebの確認間隔・アイドル整理までの秒数
KOTOHA_BACKGROUND_INTERVAL_SECONDS=60
KOTOHA_IDLE_SECONDS=300
# 整理1回あたりの上限
KOTOHA_BATCH_TURNS=20
KOTOHA_BATCH_CHARS=20000
KOTOHA_CONSOLIDATION_MAX_TOKENS=1500

# 記憶の保持日数：新規記憶に適用。既存記憶の期限は変更しません
KOTOHA_EPISODE_DAYS=30
KOTOHA_SEMANTIC_DAYS=180
# Webの忘却処理間隔（秒）。CUIは終了時に実行
KOTOHA_MAINTENANCE_SECONDS=86400
# 未使用タグの利用回数をリセットする日数
KOTOHA_TAG_RESET_DAYS=30

# 想起の件数上限
KOTOHA_TAG_CANDIDATE_LIMIT=40
KOTOHA_HOP_LIMIT=40
KOTOHA_RETRIEVE_RECENT_LIMIT=10
KOTOHA_PINNED_LIMIT=5
KOTOHA_RELATED_LIMIT=6
